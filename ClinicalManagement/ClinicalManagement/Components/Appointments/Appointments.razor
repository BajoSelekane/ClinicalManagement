@page "/Appointments"
@using ClinicalBookingSystem.Data
@using MudBlazor
@using ClinicalManagement.Domain.Entities
@using ClinicalManagement.Infrastructure
@inject NavigationManager Nav

<EditForm Model="@appointment" OnValidSubmit="SubmitLogin">
    <MudGrid>
        <MudItem>
            @* <MudTextField Label="PatientId" @bind-Value="@appointment.PatientId" /> *@
            <MudTextField Label="Phone" @bind-Value="@appointment.Phone"/>
            <MudDatePicker Label="AppointmentDate" @bind-Value="@appointment.AppointmentDate" />
            <MudDatePicker Label="EndTime" @bind-Value="@appointment.EndTime" />
           
        </MudItem>
    </MudGrid>

</EditForm>

@inject ClinicalContextDB _context

@code {
    private Appointment appointment = new();

    public class Appointment
    {
        public string PatientId { get; set; }
        public string? DoctorId { get; set; }
        public string? ClinicId { get; set; }
        public string? Phone { get; set; }
        public DateTime AppointmentDate { get; set; }
        public DateTime EndTime { get; set; }
        public Patient? patients { get; set; }
        public Doctor? doctors { get; set; }
        public Clinic? clinic { get; set; }
        public TimeSlot? timeSlot { get; set; }
    }

    private void SubmitLogin()
    {
        
    }

}



